---
import '../styles.css';
import { JUNIOR_URL, PLAY_URL } from '../config';
import { JUNIOR_PHRASES } from '@hutel/shared';
interface Props {
  title: string;
  description: string;
  page?: boolean;
  /** Lobbi Junior pages: brighter colours and the Junior play button. */
  junior?: boolean;
}
const { title, description, page = false, junior = false } = Astro.props;
const ADULT_LINES = [
  'Nogen med i biografen? 🎬',
  'Flot værelse! 😍',
  'Sneboldkamp om 5 min ❄️',
  'Hvem vil bytte en lampe? 💡',
  'Godaften lobbyen 🌙',
  'Min hund kan nu sidde 🐶',
  'Kaffe i caféen? ☕',
  'Haha 😂',
];
const lines = junior ? Object.values(JUNIOR_PHRASES).flatMap((c) => c.lines) : ADULT_LINES;
const names = junior ? ['Glad Odder 12', 'Kvik Ræv 7', 'Sød Panda 33', 'Modig Ugle 5', 'Sjov Lama 41'] : [];
const full = title === 'Lobbi' ? 'Lobbi – et hyggeligt chat-hotel i browseren' : `${title} – Lobbi`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta name="theme-color" content="#241730" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={[{ page, 'junior-site': junior }]}>
    <nav class="nav" aria-label="Hovedmenu">
      <div class="wrap">
        <a class="logo" href="/">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 23h20a10 10 0 0 0-20 0Z" fill="#ffb347"/><rect x="4" y="23" width="24" height="3" rx="1.5" fill="#e0b04a"/><circle cx="16" cy="11" r="2" fill="#ffb347"/></svg>
          Lobbi
        </a>
        <ul>
          <li><a href="/saadan-spiller-du/">Sådan spiller du</a></li>
          <li><a href="/junior/">Lobbi Junior</a></li>
          <li><a href="/nyheder/">Nyheder</a></li>
          <li><a href="/spoergsmaal/">Spørgsmål</a></li>
        </ul>
        {junior ? <a class="btn" href={JUNIOR_URL}>Spil Junior</a> : <a class="btn" href={PLAY_URL}>Spil gratis</a>}
      </div>
    </nav>
    {page && (
      <div class="page-head" aria-hidden="true">
        <div class="sparkles"></div>
        <div class="chatter" data-lines={lines.join('|')} data-names={names.join('|')}></div>
      </div>
    )}
    <main><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <div>
          <strong style="font-family:var(--display);font-size:1.3rem;color:var(--cream)">Lobbi</strong>
          <p style="margin:.4em 0 0">Et dansk chat-hotel: Lobbi for voksne og Lobbi Junior for børn. Lavet af Breinholt Digital.</p>
        </div>
        <ul>
          <li><a href="/saadan-spiller-du/">Sådan spiller du</a></li>
          <li><a href="/nyheder/">Nyheder</a></li>
          <li><a href="/spoergsmaal/">Spørgsmål og tryghed</a></li>
          <li><a href="/vilkaar/">Vilkår</a></li>
          <li><a href="/privatliv/">Privatlivspolitik</a></li>
          <li><a href="/junior/">Lobbi Junior</a></li>
          <li><a href="/junior/privatliv/">Junior: vilkår og privatliv</a></li>
        </ul>
      </div>
    </footer>
    <script>
      import { startMotion } from '../scripts/motion';
      startMotion();
    </script>
  </body>
</html>

---
import Base from '../../layouts/Base.astro';
import { RELEASE_NOTES } from '@hutel/shared';
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('da-DK', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base page title="Nyheder" description="Nyt i Lobbi: de seneste opdateringer, nye møbler, spil og funktioner.">
  <article class="prose wrap">
    <h1>Nyt i Lobbi</h1>
    <p>Vi opdaterer Lobbi tit. Her er det nyeste.</p>
    {RELEASE_NOTES.map((n) => (
      <section class="note">
        <time datetime={n.date}>{fmt(n.date)}</time>
        <h2>{n.title}</h2>
        <ul>{n.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    ))}
  </article>
</Base>
<style>
  .note {
    padding: 8px 0 20px;
    border-bottom: 1px solid rgba(255, 244, 224, 0.12);
  }
  .note time {
    color: var(--lamp);
    font-weight: 600;
  }
  .note h2 {
    margin-top: 4px;
  }
  .note ul {
    list-style: none;
    padding: 0;
  }
</style>

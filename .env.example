# ---------- Server ----------
PORT=2567
# Kommasepareret liste over tilladte klient-domæner (localhost er altid tilladt)
CLIENT_ORIGIN=http://localhost:5173
# Hvor gæster, værelser og chatlog gemmes, indtil Supabase er sat op
DATA_FILE=data/hutel-db.json
# Nye gæster skal klare startopgaverne, før de kan forlade deres værelse (true/false)
ONBOARDING_LOCK=true
# Lukket beta: kommasepareret liste over invitationskoder (tom = alle kan oprette sig)
BETA_INVITE_CODES=
# Server også den byggede klient (til én samlet deploy), fx apps/client/dist
SERVE_CLIENT=

# ---------- AI-beboere ----------
# Uden nøgle bruger beboerne faste replikker
ANTHROPIC_API_KEY=
BOT_MODEL=claude-haiku-5-5
BOT_MAX_CALLS_PER_DAY=300

# ---------- Klient (Vite læser kun VITE_-variabler) ----------
# Udelad for at bruge samme vært på port 2567
VITE_SERVER_URL=

# ---------- Supabase (når vi skifter fra fil-lager) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Social login buttons to show (comma separated): google,facebook
AUTH_PROVIDERS=google
# Let an e-mail take over an old name+password account (name:email,...). Remove afterwards.
CLAIM_NAMES=
# Test phase: "Start forfra" button under Figur. Set to false before launch.
ALLOW_RESET=true
# Names that get the admin role (comma separated, e.g. rune). Use Google login with 2FA.
ADMIN_NAMES=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Lobbi Junior ----------
# true = børneudgaven (kun på appen lobbi-junior, se fly.junior.toml)
HUTEL_JUNIOR=
# Mail til forældre (SMTP – Simply, Brevo, Resend …). Uden SMTP_HOST skrives mailen kun i loggen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Lobbi Junior <noreply@lobbi.dk>
